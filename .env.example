# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase project settings -> API. The anon key is public by design:
# all security lives in RLS and SECURITY DEFINER functions.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Public path the app is served from. Leave empty (or "/") for a root domain
# like juanominga.com; use "/Juan-o-Minga/" for aiayn-creator.github.io/Juan-o-Minga.
BASE_PATH=
